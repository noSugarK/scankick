{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScanKick",
  "version": "0.1.0-beta.4",
  "identifier": "io.github.nosugark.scankick",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run build && npm run dev:app",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ScanKick",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.1.0"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
